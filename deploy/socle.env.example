# Copiez ce fichier en socle.env (chmod 600). Secrets : openssl rand -base64 32
# Domaine des crèches : <crèche>.<DOMAINE_BASE>
DOMAINE_BASE=ticagou.nc
# Dossier des données du serveur (bases exclues) : à sauvegarder, à chiffrer.
TICAGOU_DONNEES=/opt/ticagou/donnees
POSTGRES_PASSWORD=

# Essai local seulement : certificats internes de Caddy et autres ports.
# TLS_INTERNE=1
# HTTP_PORT=8180
# HTTPS_PORT=8443

# Portail parents et supervision (./creche.sh socle --portail)
PORTAL_DOMAIN=
PORTAL_DB_PASSWORD=
PORTAL_FILE_KEY=
PORTAL_ADMIN_TOKEN=
PORTAL_SUPERVISION_EMAIL=
PORTAL_SMTP_HOST=
PORTAL_SMTP_PORT=587
PORTAL_SMTP_USER=
PORTAL_SMTP_PASSWORD=
PORTAL_MAIL_FROM=

# Console de l'éditeur (./creche.sh socle --console, ADR 0017)
# Domaine de la console ; publiée seulement pour les adresses IP listées (séparées par des espaces).
# Sans adresse : pas de site public, accès par tunnel SSH (ssh -L 8095:127.0.0.1:8095 serveur).
CONSOLE_DOMAIN=
CONSOLE_ADRESSES_AUTORISEES=
CONSOLE_DB_PASSWORD=
# Chiffre les secrets TOTP en base : à copier dans le coffre.
CONSOLE_SECRET_KEY=
# Jeton du lien https://<CONSOLE_DOMAIN>/premier-compte?jeton=… (sans effet dès qu'un compte existe) : openssl rand -hex 24
CONSOLE_SETUP_TOKEN=
# Jeton du rapport de l'hôte (creche.sh rapport-console, cron toutes les 5 min) : openssl rand -hex 24
# La supervision est lue dans le portail avec PORTAL_ADMIN_TOKEN (plus haut).
CONSOLE_HOST_TOKEN=
# Expéditeur des factures et relances de l'éditeur, par ex. Ti'Cagou <facturation@ticagou.nc> (SPF et DKIM sur le domaine).
CONSOLE_MAIL_FROM=
# Serveur SMTP de la console ; vides : ceux du portail (PORTAL_SMTP_*) servent aussi.
CONSOLE_SMTP_HOST=
CONSOLE_SMTP_PORT=
CONSOLE_SMTP_USER=
CONSOLE_SMTP_PASSWORD=

# Copie hors site : nom du dépôt rclone, chez un autre hébergeur que ce serveur.
RCLONE_DESTINATION=

# Support affiché dans l'aide de chaque crèche (bouton « ? ») ; vide : ligne masquée. Écrit dans creche.env à la création.
TICAGOU_SUPPORT_PHONE=
TICAGOU_SUPPORT_WHATSAPP=
TICAGOU_SUPPORT_EMAIL=
# Exemple : « Du lundi au vendredi, 7 h 30 – 17 h »
TICAGOU_SUPPORT_HOURS=
# Exemple : « Réponse sous 4 h ouvrées »
TICAGOU_SUPPORT_DELAY=
