# Créé et complété par ./secrets.sh (chmod 600, secrets générés, fiche du coffre). À la main : openssl rand -base64 32
# Domaine des crèches : <crèche>.<DOMAINE_BASE>
DOMAINE_BASE=ticagou.nc
# Dossier des données du serveur (bases exclues) : à sauvegarder, à chiffrer.
TICAGOU_DONNEES=/opt/ticagou/donnees
POSTGRES_PASSWORD=

# Essai local seulement : certificats internes de Caddy et autres ports.
# TLS_INTERNE=1
# HTTP_PORT=8180
# HTTPS_PORT=8443

# Portail parents et supervision (./creche.sh socle --portail)
PORTAL_DOMAIN=
PORTAL_DB_PASSWORD=
PORTAL_FILE_KEY=
PORTAL_ADMIN_TOKEN=
PORTAL_SUPERVISION_EMAIL=
PORTAL_SMTP_HOST=
PORTAL_SMTP_PORT=587
PORTAL_SMTP_USER=
PORTAL_SMTP_PASSWORD=
PORTAL_MAIL_FROM=

# Console de l'éditeur (./creche.sh socle --console, ADR 0017)
# Domaine de la console et accès :
#   internet : depuis n'importe quel ordinateur, mot de passe et code du téléphone à chaque connexion (choix par défaut) ;
#   adresses : seulement depuis les adresses IP de CONSOLE_ADRESSES_AUTORISEES (séparées par des espaces) ;
#   tunnel   : pas de site, accès par tunnel SSH (ssh -L 8095:127.0.0.1:8095 serveur).
CONSOLE_DOMAIN=
CONSOLE_ACCES=internet
CONSOLE_ADRESSES_AUTORISEES=
CONSOLE_DB_PASSWORD=
# Chiffre les secrets TOTP en base : à copier dans le coffre.
CONSOLE_SECRET_KEY=
# Jeton du lien https://<CONSOLE_DOMAIN>/premier-compte?jeton=… (sans effet dès qu'un compte existe) : openssl rand -hex 24
CONSOLE_SETUP_TOKEN=
# Jeton du rapport de l'hôte (creche.sh rapport-console, cron toutes les 5 min) : openssl rand -hex 24
# La supervision est lue dans le portail avec PORTAL_ADMIN_TOKEN (plus haut).
CONSOLE_HOST_TOKEN=
# Expéditeur des factures et relances, entre guillemets (l'apostrophe) : "Ti'Cagou <facturation@ticagou.nc>" (SPF et DKIM sur le domaine).
CONSOLE_MAIL_FROM=
# Serveur SMTP de la console ; vides : ceux du portail (PORTAL_SMTP_*) servent aussi.
CONSOLE_SMTP_HOST=
CONSOLE_SMTP_PORT=
CONSOLE_SMTP_USER=
CONSOLE_SMTP_PASSWORD=

# Copie hors site : nom du dépôt rclone, chez un autre hébergeur que ce serveur.
RCLONE_DESTINATION=

# Notifications des applications mobiles (ADR 0026) : comptes développeur de l'éditeur (décision 3 du plan).
# Vides : notifications natives désactivées, tout le reste fonctionne. Valeurs à garder aussi dans le coffre.
# APNS_KEY : contenu de la clé .p8 d'Apple en Base64 (base64 -w0 AuthKey_XXXX.p8) ; APNS_KEY_ID : son identifiant ;
# APNS_TEAM_ID : identifiant de l'équipe Apple ; APNS_PRODUCTION=false pour les builds de développement.
APNS_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRODUCTION=true
# FCM_SERVICE_ACCOUNT : fichier JSON du compte de service Firebase, en Base64 (base64 -w0 compte.json).
FCM_SERVICE_ACCOUNT=

# Support affiché dans l'aide de chaque crèche (bouton « ? ») ; vide : ligne masquée. Écrit dans creche.env à la création.
TICAGOU_SUPPORT_PHONE=
TICAGOU_SUPPORT_WHATSAPP=
TICAGOU_SUPPORT_EMAIL=
# Exemple : « Du lundi au vendredi, 7 h 30 – 17 h »
TICAGOU_SUPPORT_HOURS=
# Exemple : « Réponse sous 4 h ouvrées »
TICAGOU_SUPPORT_DELAY=
