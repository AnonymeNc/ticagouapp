# Fins de ligne indépendantes du réglage core.autocrlf de chaque poste (cohérent avec .editorconfig).
* text=auto eol=lf

# Scripts Windows : CRLF obligatoire
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Scripts shell : LF obligatoire (sinon ./mvnw échoue sous Git Bash, macOS, Linux)
*.sh text eol=lf
mvnw text eol=lf

# Binaires
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.jar binary
*.pdf binary
